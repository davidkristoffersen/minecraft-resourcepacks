{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "index": 0,
      "cases": [
        {
          "when": "night",
          "model": {
            "type": "minecraft:model",
            "model": "camera:item/polaroid_night"
          }
        },
        {
          "when": "dawn",
          "model": {
            "type": "minecraft:model",
            "model": "camera:item/polaroid_dawn"
          }
        },
        {
          "when": "sky",
          "model": {
            "type": "minecraft:model",
            "model": "camera:item/polaroid_sky"
          }
        },
        {
          "when": "green",
          "model": {
            "type": "minecraft:model",
            "model": "camera:item/polaroid_green"
          }
        },
        {
          "when": "sand",
          "model": {
            "type": "minecraft:model",
            "model": "camera:item/polaroid_sand"
          }
        },
        {
          "when": "stone",
          "model": {
            "type": "minecraft:model",
            "model": "camera:item/polaroid_stone"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "camera:item/polaroid"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "minecraft:item/filled_map",
      "tints": [
        {
          "type": "minecraft:constant",
          "value": -1
        },
        {
          "type": "minecraft:map_color",
          "default": 4603950
        }
      ]
    }
  }
}
